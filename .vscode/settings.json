{
  "cmake.sourceDirectory": "${workspaceFolder}",
  "cmake.buildDirectory": "${workspaceFolder}/build",
  "files.associations": {
    "*.hpp": "cpp",
    "*.cpp": "cpp"
  },
  "C_Cpp.default.cppStandard": "c++17",
  "C_Cpp.default.includePath": [
    "${workspaceFolder}/include",
    "${workspaceFolder}/thirdparty/hikrobot/include",
    "/opt/MVS/include",
    "/usr/include/opencv4"
  ],
  "C_Cpp.default.defines": ["IMG_DIR_OVERRIDE=3"],
  "files.exclude": {
    "**/build": true,
    "**/diag": true
  },
  "search.exclude": {
    "**/build": true,
    "**/diag": true
  }
}
